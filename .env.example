VITE_SUPABASE_URL=https://cvsefuukfmdfaajjlpmi.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Public origin of the Aval Assistant backend (Spring Boot). Client-safe — it's just an
# HTTPS URL, never a secret. Used by src/lib/api/backendClient.ts for
# POST /api/v1/assistant/messages, authenticated with the caller's own Supabase JWT.
# See docs/architecture/backend-staging.md for the current (temporary, Railway) host.
VITE_API_BASE_URL=https://aval-backend-staging-production.up.railway.app

# Server-only secrets. Required by src/routes/api/gemini-chat.ts (Gemini calls +
# distributed rate limit) and src/routes/api/push/send-reminders.ts. Never expose
# these to the client — no VITE_ prefix, so Vite won't bundle them either way.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
# Admin/service-role Supabase credential. SUPABASE_SECRET_KEY is preferred — it's
# the name the official Vercel<->Supabase integration creates automatically.
# SUPABASE_SERVICE_ROLE_KEY is a temporary fallback for the older manual setup;
# code checks SUPABASE_SECRET_KEY first. Only one of the two needs a real value.
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
CRON_SECRET=your_cron_secret
VAPID_PRIVATE_KEY=your_vapid_private_key

# Client-safe (VITE_ prefix — Vite bundles this into the client on purpose). This is
# the public half of the VAPID keypair used for Web Push subscriptions.
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key
