# Aval backend — environment variables. Copy to .env for local development.
# Never commit real values. See README.md "Auth" and "Banco de dados" for
# how each of these is used.

# ---- Server ----
SERVER_PORT=8081

# ---- Database (same Supabase/PostgreSQL instance the PWA already uses) ----
# Use the Supabase "session" (non-pooled, IPv4-friendly) connection string
# for local dev, or the pooled one in production per Supabase's own guidance.
DATABASE_URL=jdbc:postgresql://localhost:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# ---- Supabase Auth (JWT validation only — see ADR-003) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# ---- CORS ----
# Comma-separated list of exact origins. Never "*" together with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:8080,https://aval-v1.vercel.app

# ---- Observability (OpenTelemetry) ----
# Leave unset locally — the OTLP exporter no-ops without an endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=aval-backend

# ---- Actuator ----
# Comma-separated list of exposed actuator endpoints. Keep this narrow in production.
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,prometheus
